      "era": "mixed",
      "reliable": false,
      "message": "Say what the reader can now do.",
      "examples": {
        "matching": ["empower"],
        "clean": []
      },
      "attribution": "hwajongpark/slop-gate § vocabulary (MIT)"
    },
